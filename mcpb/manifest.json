          "min_duration_s": {
            "type": "number",
            "description": "Minimum acceptable duration in seconds (default: 0.5)."
          },
          "max_silence_ratio": {
            "type": "number",
            "description": "Maximum allowed ratio of silence (default: 0.98)."
          }
