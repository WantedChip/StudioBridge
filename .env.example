# StudioBridge Environment Configuration Template
# Copy this file to .env and adjust values for your local environment.
# Never commit .env to version control.

# MIDI Ports & Transport Configuration
SBRIDGE_PORT_ROOT=SBridge
SBRIDGE_PORT_IN=SBridge (A)
SBRIDGE_PORT_OUT=SBridge (A)

# Broker & IPC
SBRIDGE_BROKER_HOST=127.0.0.1
SBRIDGE_BROKER_PORT=49880
SBRIDGE_LOG_LEVEL=INFO

# Safety & Permissions
# 1 = Read-only mode (default, prevents unconfirmed mutations)
# 0 = Allow verified mutations
SBRIDGE_READ_ONLY=1

# FL Studio Paths (Optional, auto-discovered if unset)
# FL_USER_DATA_PATH="C:\Users\Username\Documents\Image-Line\FL Studio"
# FL_INSTALL_PATH="C:\Program Files\Image-Line\FL Studio 2026"
