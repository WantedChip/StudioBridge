{
  "name": "channels_list",
  "title": "Channels List",
  "description": "List generator channels in the channel rack with volume, pan, mute/solo states, and step bits. Supports limit/cursor pagination.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "limit": {
        "type": "integer",
        "default": 20,
        "minimum": 1,
        "maximum": 100,
        "description": "Maximum channels to return (default: 20)"
      },
      "cursor": {
        "type": "integer",
        "default": 0,
        "minimum": 0,
        "description": "Starting channel index (0-based)"
      },
      "fields": {
        "type": "array",
        "items": { "type": "string" },
        "description": "Fields to include in each channel object or 'all'"
      }
    },
    "additionalProperties": false
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "channels": {
        "type": "array",
        "items": { "type": "object" }
      },
      "total": { "type": "integer" },
      "limit": { "type": "integer" },
      "cursor": { "type": "integer" },
      "next_cursor": { "type": ["integer", "null"] }
    },
    "required": ["channels", "total", "limit", "cursor"]
  }
}
