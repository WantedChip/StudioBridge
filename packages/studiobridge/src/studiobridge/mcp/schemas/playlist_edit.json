{
  "name": "playlist_edit",
  "title": "Playlist Edit",
  "description": "Edit arrangement playlist track: rename, color, mute, or solo.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "track": {
        "type": "integer",
        "description": "Playlist track number (1-based)"
      },
      "name": {
        "type": "string",
        "description": "New playlist track label"
      },
      "color": {
        "type": ["string", "integer"],
        "description": "New color hex or RGB integer"
      },
      "mute": {
        "type": "boolean",
        "description": "Mute state"
      },
      "solo": {
        "type": "boolean",
        "description": "Solo state"
      },
      "confirm_token": {
        "type": "string",
        "description": "One-time human confirmation challenge token"
      },
      "verify": {
        "type": "boolean",
        "description": "Whether to perform read-back verification after mutation"
      }
    },
    "required": ["track"],
    "additionalProperties": false
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "verified": { "type": "boolean" },
      "plane": { "type": "string" },
      "journal_id": { "type": "integer" },
      "track": { "type": "integer" }
    },
    "required": ["verified", "plane", "journal_id", "track"]
  }
}
