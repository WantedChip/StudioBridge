{
  "name": "playlist_place_pattern",
  "title": "Playlist Place Pattern",
  "description": "Place pattern clip onto arrangement playlist track at normalized time position (experimental).",
  "inputSchema": {
    "type": "object",
    "properties": {
      "track": {
        "type": "integer",
        "description": "Playlist track number (1-based)"
      },
      "pattern": {
        "type": "integer",
        "description": "Pattern number to place (1-based)"
      },
      "time": {
        "type": "number",
        "description": "Normalized timeline position (0.0 to 1.0) or bar position"
      },
      "confirm_token": {
        "type": "string",
        "description": "One-time human confirmation challenge token"
      },
      "verify": {
        "type": "boolean",
        "description": "Whether to perform read-back verification after mutation"
      }
    },
    "required": ["track", "pattern", "time"],
    "additionalProperties": false
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "verified": { "type": "boolean" },
      "plane": { "type": "string" },
      "journal_id": { "type": "integer" },
      "track": { "type": "integer" },
      "pattern": { "type": "integer" },
      "time": { "type": "number" }
    },
    "required": ["verified", "plane", "journal_id", "track", "pattern", "time"]
  }
}
