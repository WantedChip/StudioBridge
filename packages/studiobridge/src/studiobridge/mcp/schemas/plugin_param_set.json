{
  "name": "plugin_param_set",
  "title": "Plugin Parameter Set",
  "description": "Set normalized parameter value (0.0 to 1.0) on an instrument or effect plugin.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "param_index": {
        "type": "integer",
        "description": "0-based parameter index within plugin"
      },
      "value": {
        "type": "number",
        "description": "Normalized target parameter value (0.0 to 1.0)"
      },
      "target": {
        "type": "string",
        "description": "Plugin target specifier (e.g. 'mixer.track.0.slot.0' or 'channel.0')"
      },
      "track": {
        "type": "integer",
        "description": "Mixer track index if targeting mixer effect plugin"
      },
      "slot": {
        "type": "integer",
        "description": "Mixer slot index (0-9) if targeting mixer effect plugin"
      },
      "channel": {
        "type": "integer",
        "description": "Channel index if targeting generator plugin"
      },
      "allow_protected": {
        "type": "boolean",
        "description": "Allow adjusting protected plugin parameters"
      },
      "confirm_token": {
        "type": "string",
        "description": "One-time human confirmation challenge token"
      },
      "verify": {
        "type": "boolean",
        "description": "Whether to perform read-back verification after mutation"
      }
    },
    "required": ["param_index", "value"],
    "additionalProperties": false
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "verified": { "type": "boolean" },
      "plane": { "type": "string" },
      "journal_id": { "type": "integer" },
      "param_index": { "type": "integer" },
      "value": { "type": "number" }
    },
    "required": ["verified", "plane", "journal_id", "param_index", "value"]
  }
}
