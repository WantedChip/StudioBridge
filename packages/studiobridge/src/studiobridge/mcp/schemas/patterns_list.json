{
  "name": "patterns_list",
  "title": "Patterns List",
  "description": "List patterns in the project with names, lengths, colors, and active pattern indicator. Supports pagination.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "limit": {
        "type": "integer",
        "default": 20,
        "minimum": 1,
        "maximum": 100,
        "description": "Maximum patterns to return (default: 20)"
      },
      "cursor": {
        "type": "integer",
        "default": 1,
        "minimum": 1,
        "description": "Starting pattern number (1-based per FL conventions)"
      },
      "fields": {
        "type": "array",
        "items": { "type": "string" },
        "description": "Fields to include in each pattern object or 'all'"
      }
    },
    "additionalProperties": false
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "patterns": {
        "type": "array",
        "items": { "type": "object" }
      },
      "total": { "type": "integer" },
      "active_pattern": { "type": "integer" },
      "limit": { "type": "integer" },
      "cursor": { "type": "integer" },
      "next_cursor": { "type": ["integer", "null"] }
    },
    "required": ["patterns", "total", "active_pattern", "limit", "cursor"]
  }
}
