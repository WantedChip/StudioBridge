{
  "name": "plugin_params_list",
  "title": "Plugin Params List",
  "description": "List parameters of an effect plugin on a mixer track slot or generator plugin on a channel.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "track": {
        "type": "integer",
        "description": "Mixer track index (0-126)"
      },
      "slot": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9,
        "description": "Effect slot index (0-9)"
      },
      "limit": {
        "type": "integer",
        "default": 50,
        "minimum": 1,
        "maximum": 500,
        "description": "Maximum parameters to return (default: 50)"
      },
      "cursor": {
        "type": "integer",
        "default": 0,
        "minimum": 0,
        "description": "Starting parameter index"
      },
      "fields": {
        "type": "array",
        "items": { "type": "string" },
        "description": "Fields to include in each parameter object or 'all'"
      }
    },
    "required": ["track", "slot"],
    "additionalProperties": false
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "plugin_name": { "type": "string" },
      "param_count": { "type": "integer" },
      "params": {
        "type": "array",
        "items": { "type": "object" }
      },
      "limit": { "type": "integer" },
      "cursor": { "type": "integer" },
      "next_cursor": { "type": ["integer", "null"] }
    },
    "required": ["plugin_name", "param_count", "params", "limit", "cursor"]
  }
}
