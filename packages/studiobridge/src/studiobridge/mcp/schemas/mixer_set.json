{
  "name": "mixer_set",
  "title": "Mixer Set",
  "description": "Adjust volume, pan, mute, solo, or name across one or more mixer tracks with verification.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "tracks": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "track": { "type": "integer" },
            "volume": { "type": "number" },
            "pan": { "type": "number" },
            "mute": { "type": "boolean" },
            "solo": { "type": "boolean" },
            "name": { "type": "string" }
          },
          "required": ["track"]
        },
        "description": "Array of mixer track adjustments"
      },
      "track": {
        "type": "integer",
        "description": "Single track index (0-126) for convenience"
      },
      "volume": {
        "type": "number",
        "description": "Normalized volume (0.0 to 1.0) or dB value"
      },
      "pan": {
        "type": "number",
        "description": "Normalized pan (-1.0 to 1.0)"
      },
      "mute": {
        "type": "boolean",
        "description": "Mute state"
      },
      "solo": {
        "type": "boolean",
        "description": "Solo state"
      },
      "name": {
        "type": "string",
        "description": "Track display name"
      },
      "allow_protected": {
        "type": "boolean",
        "description": "Allow adjusting protected master track (track 0)"
      },
      "confirm_token": {
        "type": "string",
        "description": "One-time human confirmation challenge token"
      },
      "verify": {
        "type": "boolean",
        "description": "Whether to perform read-back verification after mutation"
      }
    },
    "additionalProperties": false
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "verified": { "type": "boolean" },
      "plane": { "type": "string" },
      "journal_id": { "type": "integer" },
      "track_count": { "type": "integer" },
      "receipts": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "track": { "type": "integer" },
            "verified": { "type": "boolean" },
            "plane": { "type": "string" },
            "journal_id": { "type": "integer" }
          },
          "required": ["track", "verified", "plane", "journal_id"]
        }
      }
    },
    "required": ["verified", "plane", "journal_id"]
  }
}
