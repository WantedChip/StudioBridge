{
  "name": "api_search",
  "title": "API Search",
  "description": "Search FL Studio Python scripting API functions, modules, and constants by keyword or module filter.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "query": {
        "type": "string",
        "description": "Keyword to search in function names, summaries, or docstrings"
      },
      "module": {
        "type": "string",
        "description": "Filter by module name (e.g. 'mixer', 'transport', 'channels', 'patterns', 'general', 'playlist')"
      },
      "limit": {
        "type": "integer",
        "default": 20,
        "minimum": 1,
        "maximum": 100,
        "description": "Maximum number of search results to return"
      },
      "include_constants": {
        "type": "boolean",
        "default": false,
        "description": "Include module constants matching query"
      }
    },
    "additionalProperties": false
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "matches": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "module": { "type": "string" },
            "name": { "type": "string" },
            "signature": { "type": "string" },
            "summary": { "type": "string" },
            "mutating": { "type": "boolean" },
            "since": { "type": "integer" }
          },
          "required": ["module", "name", "signature"]
        }
      },
      "total": { "type": "integer" },
      "query": { "type": ["string", "null"] },
      "module": { "type": ["string", "null"] },
      "limit": { "type": "integer" }
    },
    "required": ["matches", "total", "limit"]
  }
}
