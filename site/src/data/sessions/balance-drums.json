  "steps": [
    {
      "stepNumber": 0,
      "role": "user",
      "text": "The drum bus is clipping at +1.8 dB on the master channel. Inspect tracks 1 to 4, attenuate the hot snare and hi-hat tracks by ~3 dB, and verify write tolerances.",
