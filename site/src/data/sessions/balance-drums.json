        "view": "mixer",
        "description": "Initial mixer state: Snare and Open Hat are hot, causing bus distortion.",
        "mixer": {
          "tracks": [
            { "id": 0, "name": "Master", "volume": 1.0, "pan": 0.0, "peakDb": 1.8, "mute": false, "solo": false, "clipping": true },
            { "id": 1, "name": "Kick", "volume": 0.85, "pan": 0.0, "peakDb": -0.4, "mute": false, "solo": false, "clipping": false },
            { "id": 2, "name": "Snare", "volume": 0.92, "pan": -0.1, "peakDb": 1.8, "mute": false, "solo": false, "clipping": true, "highlighted": true },
