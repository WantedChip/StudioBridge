{
  "id": "balance-drums",
  "title": "Balance Drum Bus & Tolerance Check",
  "tabLabel": "Balance Drums",
  "summary": "Inspect drum track faders, attenuate clipping snare and open-hat levels, and verify write tolerances with read-back comparison.",
