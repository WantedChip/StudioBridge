          { "track": 1, "name": "Kick", "volume": 0.85, "pan": 0.0, "peak_db": -0.4, "status": "ok" },
          { "track": 2, "name": "Snare", "volume": 0.92, "pan": -0.1, "peak_db": 1.8, "status": "clipping" },
          { "track": 3, "name": "Closed Hat", "volume": 0.70, "pan": 0.25, "peak_db": -4.2, "status": "ok" },
          { "track": 4, "name": "Open Hat", "volume": 0.88, "pan": 0.35, "peak_db": 0.6, "status": "clipping" }
        ],
        "bus_peak_db": 1.8
