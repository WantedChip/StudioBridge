---
import '../styles/global.css';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Bridge coding agents to FL Studio with verified writes, reversibility, and local execution." />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>StudioBridge — Agent Bridge for FL Studio</title>
  </head>
  <body class="min-h-screen bg-[#F3F0E8] text-[#181815] font-sans antialiased">
    <header class="border-b border-[#181815]/10 px-6 py-4 flex items-center justify-between">
      <div class="font-bold tracking-tight text-xl">StudioBridge</div>
      <nav class="flex items-center gap-6 text-sm">
        <a href="/docs" class="hover:underline">Documentation</a>
        <a href="https://github.com/WantedChip/studiobridge" class="hover:underline" target="_blank" rel="noopener noreferrer">GitHub</a>
      </nav>
    </header>
    <main class="max-w-4xl mx-auto px-6 py-20">
      <div class="text-xs font-mono uppercase tracking-widest text-[#E8461A] mb-3">01 / SIGNAL PATH</div>
      <h1 class="text-4xl md:text-5xl font-extrabold tracking-tight mb-6">
        Patch your agent into your DAW.
      </h1>
      <p class="text-lg md:text-xl text-[#181815]/80 mb-8 max-w-2xl leading-relaxed">
        Read, edit and render FL Studio projects from any coding agent — verified, reversible, local.
      </p>
      <div class="flex flex-wrap items-center gap-4">
        <a
          href="/docs"
          class="inline-flex items-center px-5 py-2.5 bg-[#181815] text-[#F3F0E8] font-medium text-sm rounded hover:bg-[#181815]/90 transition"
        >
          Explore Docs &rarr;
        </a>
        <a
          href="https://github.com/WantedChip/studiobridge"
          class="inline-flex items-center px-5 py-2.5 border border-[#181815]/30 text-[#181815] font-medium text-sm rounded hover:bg-[#181815]/5 transition"
          target="_blank"
          rel="noopener noreferrer"
        >
          View Source
        </a>
      </div>
    </main>
  </body>
</html>
