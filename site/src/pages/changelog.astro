---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import JsonLd from '../components/JsonLd.astro';

const RELEASES = [
  {
    version: 'v0.6.0',
    date: '2026-10-26',
    title: 'Landing Page, Starlight Docs & Design System',
    tag: 'LATEST RELEASE',
    summary:
      'Official web launch featuring the interactive Signal-Path hero diagram, capability matrix explorer for Windows ARM64/x64, console demo island with authentic transcripts, complete Starlight documentation suite with 119 API function cards, automated llms.txt context compilation, OpenGraph social card generation, and comprehensive SEO/GEO schema.org metadata.',
    highlights: [
      'Interactive Signal-Path hero island with live SysEx frame data inspection',
      'Dual-selector capability matrix explorer with diagnostic bundle provenance',
      'Starlight documentation portal with full doctor check recovery directory',
      'Auto-generated API reference across all 8 FL Studio controller modules',
      'Automated machine-readable llms.txt and llms-full.txt context files',
      'OpenGraph and Twitter social card generator on the Paper palette',
    ],
  },
  {
    version: 'v0.5.0',
    date: '2026-10-25',
    title: 'Offline FLP Engine & Binary Codec',
    tag: 'FEATURE COMPLETE',
    summary:
      'Lossless binary FLP project parser and AST-level mutation engine. Enables inspection, editing, and synthesis of FL Studio project files without launching the host DAW application.',
    highlights: [
      'Binary FLP parser supporting FL Studio 21 through 26 format profiles',
      'Lossless AST round-trip mutation with structural invariant guards',
      'Seed template instantiation CLI (`sbridge flp template add`)',
      'Offline FLP Model Context Protocol (MCP) tool suite',
    ],
  },
  {
    version: 'v0.4.0',
    date: '2026-10-24',
    title: 'Piano Roll Actuation & Headless Render Orchestration',
    tag: 'FEATURE COMPLETE',
    summary:
      'Focus-guarded Win32 window actuation and headless command-line render supervision with automated acoustic verification.',
    highlights: [
      'Win32 foreground window management with focus guards and note entry macros',
      'Piano-roll oracle verification via note read-back SHA-256 hash comparison',
      'Headless FL Studio WAV/MP3 render job runner with freeze detection',
      'Audio output validator reporting peak dBFS, RMS, and clipping statistics',
    ],
  },
  {
    version: 'v0.3.0',
    date: '2026-10-23',
    title: 'Model Context Protocol (MCP) Server & Agent Skills',
    tag: 'FEATURE COMPLETE',
    summary:
      'Production Model Context Protocol (MCP) server exposing DAW inspection, live control, safety interlocks, and agent installer for 10 coding agents and IDEs.',
    highlights: [
      'Inspect tool suite (`mixer_list`, `channel_list`, `pattern_list`, `project_info`)',
      'Live control tool suite (`mixer_set`, `channel_set`, `transport_set`, `notes_apply`)',
      'Mutation journal and safety interlock suite (`session_mode_set`, `checkpoint_rollback`)',
      'One-line installer templates for Claude Code, Cursor, Codex, Antigravity, and 6 more',
    ],
  },
  {
    version: 'v0.2.0',
    date: '2026-10-22',
    title: 'API Manifest & Core Python SDK',
    tag: 'FEATURE COMPLETE',
    summary:
      'Typed Python SDK wrapping the FL Studio controller API with verified write tolerances, protected targets, and append-only mutation journal.',
    highlights: [
      'Strictly typed Python SDK across 8 namespaces (`transport`, `mixer`, `channels`, etc.)',
      'Verified writes with read-back comparison against configurable tolerances',
      'Safety interlock levels (G0-G2) with transaction rollback guarantees',
      'Clean-room API manifest compiler with drift detection CI',
    ],
  },
  {
    version: 'v0.1.0',
    date: '2026-10-21',
    title: 'Foundation, Wire Protocol & ctypes WinMM',
    tag: 'FOUNDATION',
    summary:
      'Zero-dependency virtual MIDI backend for Windows ARM64 and x64, 2-way SysEx RPC framing with CRC-16 CCITT verification, and the 26-point setup doctor.',
    highlights: [
      'Pure-Python ctypes WinMM virtual MIDI backend with zero native dependencies',
      'SysEx framing with CRC-16 CCITT (0x1021) and 512-byte packet chunking',
      'Setup doctor CLI (`sbridge doctor`) validating 26 diagnostic checks',
      'Device script generator and local loopback emulator',
    ],
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="Changelog, release notes, and architecture updates for StudioBridge — the agent bridge for FL Studio. Read, edit, and render FL Studio projects from any coding agent."
    />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#F3F0E8" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0F0F0D" media="(prefers-color-scheme: dark)" />

    <link rel="canonical" href="https://studiobridge.dev/changelog" />
    <link rel="alternate" type="application/rss+xml" title="StudioBridge Releases RSS Feed" href="https://studiobridge.dev/rss.xml" />

    <!-- OpenGraph & Twitter Card Metadata -->
    <meta property="og:title" content="Changelog &amp; Releases — StudioBridge" />
    <meta
      property="og:description"
      content="Changelog, release notes, and architecture updates for StudioBridge — the agent bridge for FL Studio."
    />
    <meta property="og:image" content="https://studiobridge.dev/og.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://studiobridge.dev/changelog" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Changelog &amp; Releases — StudioBridge" />
    <meta
      name="twitter:description"
      content="Changelog, release notes, and architecture updates for StudioBridge — the agent bridge for FL Studio."
    />
    <meta name="twitter:image" content="https://studiobridge.dev/og.png" />

    <link rel="preload" href="/fonts/bricolage-grotesque-latin.woff2" as="font" type="font/woff2" crossorigin="anonymous" />
    <link rel="preload" href="/fonts/inter-tight-latin.woff2" as="font" type="font/woff2" crossorigin="anonymous" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Changelog &amp; Releases — StudioBridge</title>

    <script is:inline>
      (function () {
        try {
          var theme = localStorage.getItem('sb-theme');
          if (theme === 'dark') {
            document.documentElement.setAttribute('data-theme', 'dark');
          } else if (theme === 'light') {
            document.documentElement.setAttribute('data-theme', 'light');
          } else {
            document.documentElement.removeAttribute('data-theme');
          }
        } catch (_) {}
      })();
    </script>

    <!-- Schema.org SoftwareApplication JSON-LD -->
    <JsonLd
      title="Changelog & Releases — StudioBridge"
      description="Changelog, release notes, and architecture updates for StudioBridge — the agent bridge for FL Studio."
      url="https://studiobridge.dev/changelog"
    />
  </head>
  <body class="min-h-screen bg-bg text-ink font-sans antialiased selection:bg-signal selection:text-white">
    <Header />

    <main id="main-content" class="py-12 px-4 sm:px-6 lg:px-8">
      <div class="max-w-5xl mx-auto">
        <!-- Breadcrumb & Top Bar -->
        <div class="flex items-center justify-between pb-6 mb-8 border-b border-line">
          <div class="flex items-center gap-2 font-mono text-xs text-ink-muted">
            <a href="/" class="hover:text-ink transition-colors focus-ring rounded-[1px]">StudioBridge</a>
            <span>/</span>
            <span class="text-ink font-semibold">Changelog</span>
          </div>

          <!-- RSS Feed Link -->
          <a
            href="/rss.xml"
            class="inline-flex items-center gap-2 px-3 py-1.5 rounded-[2px] border border-line-strong text-ink font-mono text-xs hover:border-signal transition-colors focus-ring"
            target="_blank"
            rel="noopener noreferrer"
          >
            <span class="w-2 h-2 rounded-full bg-signal inline-block" aria-hidden="true"></span>
            <span>RSS 2.0 Feed</span>
            <span aria-hidden="true">&rarr;</span>
          </a>
        </div>

        <!-- Header Title -->
        <div class="mb-12">
          <div class="font-mono text-xs uppercase tracking-widest text-signal font-semibold mb-2">
            RELEASE LOG &amp; ARCHITECTURE UPDATES
          </div>
          <h1 class="font-display text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-ink mb-4">
            Releases &amp; Changelog
          </h1>
          <p class="font-sans text-base sm:text-lg text-ink-muted max-w-3xl leading-relaxed">
            Every version of StudioBridge follows strict clean-room engineering, verified write semantics, and transparent architecture milestones. Subscribe to the RSS feed for instant release notifications.
          </p>
        </div>

        <!-- Release Timeline -->
        <div class="space-y-12">
          {
            RELEASES.map((rel) => (
              <article
                id={rel.version}
                class="border border-line rounded-[2px] bg-surface p-6 sm:p-8 relative"
              >
                <!-- Top metadata row -->
                <div class="flex flex-wrap items-center justify-between gap-3 pb-4 mb-4 border-b border-line">
                  <div class="flex items-center gap-3">
                    <span class="font-mono text-lg sm:text-xl font-bold text-ink">
                      {rel.version}
                    </span>
                    <span class="font-mono text-[10px] tracking-wide px-2 py-0.5 rounded-[1px] bg-surface border border-line-strong text-ink font-semibold">
                      {rel.tag}
                    </span>
                  </div>
                  <time class="font-mono text-xs text-ink-muted tabular-nums" datetime={rel.date}>
                    {rel.date}
                  </time>
                </div>

                <h2 class="font-display text-xl sm:text-2xl font-bold text-ink mb-3">
                  {rel.title}
                </h2>
                <p class="font-sans text-sm sm:text-base text-ink-muted leading-relaxed mb-6">
                  {rel.summary}
                </p>

                <!-- Highlights List -->
                <div>
                  <h3 class="font-mono text-xs uppercase tracking-wider text-ink font-semibold mb-3">
                    Key Highlights &amp; Capabilities
                  </h3>
                  <ul class="space-y-2 font-sans text-xs sm:text-sm text-ink-muted">
                    {rel.highlights.map((item) => (
                      <li class="flex items-start gap-2.5">
                        <span class="w-1.5 h-1.5 rounded-[1px] bg-signal mt-1.5 shrink-0" aria-hidden="true" />
                        <span>{item}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </main>

    <Footer />
  </body>
</html>
