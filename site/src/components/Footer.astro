            </li>
            <li>
              <a href="/compat" class="hover:text-ink transition-colors focus-ring rounded-[1px]">
                Capability Matrix
              </a>
            </li>
          </ul>
        </div>

        <div>
          <div class="font-mono text-[10px] uppercase tracking-wider text-ink font-semibold mb-3">
            Project
          </div>
          <ul class="space-y-2 text-ink-muted">
            <li>
              <a href="/changelog" class="hover:text-ink transition-colors focus-ring rounded-[1px]">
                Changelog &amp; Releases
              </a>
            </li>
            <li>
              <a href="/llms.txt" class="hover:text-ink transition-colors focus-ring rounded-[1px]">
                llms.txt Context
              </a>
            </li>
            <li>
              <a
                href="https://github.com/WantedChip/studiobridge/blob/main/SECURITY.md"
