<footer class="border-t border-line bg-surface py-12 px-4 sm:px-6 lg:px-8">
  <div class="max-w-7xl mx-auto">
    <!-- Top Row: Wordmark, Status Line, Navigation -->
    <div class="flex flex-col lg:flex-row lg:items-start justify-between gap-8 pb-10 border-b border-line">
      <div>
        <div class="flex items-center gap-2.5 font-display font-bold tracking-tight text-xl text-ink mb-2">
          <span class="w-2 h-2 rounded-[1px] bg-signal inline-block" aria-hidden="true"></span>
          <span>StudioBridge</span>
        </div>
        <p class="font-sans text-xs text-ink-muted max-w-sm leading-relaxed mb-4">
          Independent open-source DAW automation bridge for coding agents and language models. Verified writes, reversibility, and local execution.
        </p>
        <div class="font-mono text-[11px] text-ink-muted tabular-nums space-y-1">
          <div>TELEMETRY: <span class="text-ok font-semibold">ZERO // 100% LOCAL</span></div>
          <div>PROTOCOL: <span class="text-ink font-semibold">MIDI-SYSEX 53 42</span></div>
          <div>PLATFORM: <span class="text-ink font-semibold">WINDOWS x64 &amp; ARM64</span></div>
        </div>
      </div>

      <!-- Navigation Columns -->
      <div class="grid grid-cols-2 sm:grid-cols-3 gap-8 font-sans text-xs">
        <div>
          <div class="font-mono text-[10px] uppercase tracking-wider text-ink font-semibold mb-3">
            Documentation
